# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
DB_PATH=./data/omid_hospital.db

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:3000,https://omid-hospital.up.railway.app

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Admin Default Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@omid-hospital.ir
ADMIN_PHONE=09123456789
