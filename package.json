{
  "name": "omid-hospital",
  "version": "1.0.0",
  "description": "Omid Hospital Management System - Full Stack",
  "main": "server/server.js",
  "scripts": {
    "start": "cd server && node server.js",
    "dev": "cd server && nodemon server.js",
    "seed": "cd server && node scripts/seed.js",
    "build": "node --check server/server.js",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply omid-hospital --remote",
    "cf:deploy": "wrangler deploy",
    "postinstall": "cd server && npm install"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  },
  "keywords": [
    "hospital",
    "medical",
    "appointment"
  ],
  "author": "Omid Hospital",
  "license": "MIT"
}
